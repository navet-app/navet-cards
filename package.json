{
  "name": "navet-cards",
  "version": "0.1.0-beta.3",
  "private": true,
  "description": "Configurable Navet cards for Home Assistant dashboards",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": "github:navet-app/navet-cards",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs --modular",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm test && npm run test:release && npm run test:build && npm run build && npm run test:browser",
    "test:build": "node --test tests/bundle-report.test.mjs tests/artifact-manifest.test.mjs",
    "ha:validation": "node scripts/ha-validation.mjs",
    "test:live": "node --import tsx --test tests/live/*.test.ts",
    "package:verification": "npm run check && node scripts/package-verification.mjs",
    "build:preview": "npm run build && node scripts/package-preview.mjs",
    "test:release": "node --test tests/release.test.mjs",
    "screenshots:readme": "node scripts/readme-screenshots.mjs"
  },
  "dependencies": {
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
